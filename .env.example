# TechPulse AI Environment Configuration

# Database & Cache
DATABASE_URL=sqlite+aiosqlite:///./techpulse.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/techpulse_db
REDIS_URL=redis://localhost:6379/0

# Authentication
AUTH_SECRET=techpulse-super-secure-production-jwt-secret-key-32-chars

# LLM Providers (Optional - high-fidelity deterministic fallback active if omitted)

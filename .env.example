ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Ingestion Source APIs (Optional - live public APIs and fallback active)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_TOKEN=
NEWS_API_KEY=
PRODUCT_HUNT_TOKEN=

# Mobile Push Notifications
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

{
  "buildCommand": "cd apps/web && npm install && npm run build",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://localhost:8000/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "http://localhost:8000/ws/:path*"
    }
  ]
}
